<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <parent><groupId>io.github.aidarnig</groupId><artifactId>wristporter</artifactId><version>1.1.0</version></parent>
 <artifactId>watch-desktop</artifactId>
 <dependencies><dependency><groupId>io.github.aidarnig</groupId><artifactId>watch-domain</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>io.github.aidarnig</groupId><artifactId>watch-adb</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>io.github.aidarnig</groupId><artifactId>watch-core</artifactId><version>${project.version}</version></dependency>
<dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
<dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
<dependency><groupId>io.github.mkpaz</groupId><artifactId>atlantafx-base</artifactId><version>${atlantafx.version}</version></dependency>  <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
 </dependencies>
 <build>
  <resources>
   <resource><directory>src/main/resources</directory></resource>
   <resource>
    <directory>../docs/assets</directory>
    <targetPath>branding</targetPath>
    <includes>
     <include>logo-light.png</include>
     <include>logo-dark.png</include>
     <include>watch-icon.png</include>
    </includes>
   </resource>
  </resources>
  <plugins><plugin><groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId><version>0.0.8</version><configuration><mainClass>io.github.aidarnig.wgs.desktop.DesktopLauncher</mainClass></configuration></plugin></plugins></build>
</project>
